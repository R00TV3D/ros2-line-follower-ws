<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="line_bot">
    <pose>0 0 0.1 0 0 0</pose>

    <!-- 1. BLUE CHASSIS -->
    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0077</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0160</iyy><iyz>0</iyz><izz>0.0216</izz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <geometry><box><size>0.30 0.20 0.08</size></box></geometry>
        <material>
          <ambient>0.1 0.4 0.9 1</ambient>
          <diffuse>0.1 0.4 0.9 1</diffuse>
        </material>
      </visual>
      <collision name="chassis_collision">
        <geometry><box><size>0.30 0.20 0.08</size></box></geometry>
      </collision>

      <!-- FRONT CASTER SPHERE (Built into chassis for zero-glitch physics) -->
      <visual name="caster_visual">
        <pose>0.10 0 -0.04 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material>
          <ambient>0.7 0.7 0.7 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <collision name="caster_collision">
        <pose>0.10 0 -0.04 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.001</mu><mu2>0.001</mu2></ode></friction>
        </surface>
      </collision>

      <!-- RED CAMERA BOX + DOWNWARD SENSOR -->
      <visual name="camera_visual">
        <pose>0.15 0 0.06 0 0.5 0</pose>
        <geometry><box><size>0.03 0.06 0.03</size></box></geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="line_camera" type="camera">
        <pose>0.15 0 0.06 0 0.5 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>10.0</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- 2. LEFT WHEEL -->
    <link name="left_wheel">
      <pose>-0.08 0.12 -0.02 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz><izz>0.0004</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- 3. RIGHT WHEEL -->
    <link name="right_wheel">
      <pose>-0.08 -0.12 -0.02 -1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002</iyy><iyz>0</iyz><izz>0.0004</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- 4. DIFF DRIVE & SENSOR PLUGINS -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </model>
</sdf>
